---
import "../styles/global.css";
interface Props {
  title: string;
  sesion?: { usuario: { email: string } } | null;
}

const { title, sesion = null } = Astro.props;
const rutaActual = Astro.url.pathname;
const nombreUsuario = sesion?.usuario.email
  .split("@")[0]
  .split(/[._-]/)
  .filter(Boolean)
  .map((parte:any) => parte.charAt(0).toUpperCase() + parte.slice(1))
  .join(" ");
const inicial = nombreUsuario?.charAt(0) || "U";

const enlaces = [
  { href: "/dashboard", etiqueta: "Mi rutina", icono: "rutina" },
  { href: "/asistencias", etiqueta: "Asistencias", icono: "historial" },
] as const;

const enlacesMoviles = [
  { href: "/dashboard", etiqueta: "Inicio", icono: "fitness_center" },
  { href: "/maquinas", etiqueta: "Máquinas", icono: "sports_gymnastics" },
  { href: "/rutinas", etiqueta: "Rutinas", icono: "local_fire_department" },
  { href: "/perfil", etiqueta: "Perfil", icono: "account_circle" },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#781326" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ "app-body": sesion, "auth-body": !sesion }}>
    {
      sesion ? (
        <div class="app-shell">
          <header class="app-topbar">
            <div class="topbar-content">
              <a href="/dashboard" class="brand" aria-label="UES Fit, inicio">
                <span class="brand-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M13.1 2.3c.3 3-1.9 4.2-3 6.1-.8 1.4-.7 3.1.5 4.2-.1-2.2 1.1-3.4 2.4-4.7.5 2.6 3.4 3.9 3.4 7.1 0 2.7-2 5-4.7 5-2.9 0-5.2-2.2-5.2-5.2 0-3.6 2.5-5.7 6.6-12.5Z" fill="currentColor" />
                    <path d="M12 12.2c.2 1.5-1 2-1.4 3-.5 1.2.1 2.5 1.4 2.5 1.2 0 2-.9 2-2.1 0-1.5-1.2-2.3-2-3.4Z" fill="#ffae32" />
                  </svg>
                </span>
                <span>
                  <strong>UES FIT</strong>
                  <small>Bienestar universitario</small>
                </span>
              </a>

              <nav class="desktop-nav" aria-label="Navegación principal">
                {enlaces.map((enlace) => (
                  <a
                    href={enlace.href}
                    class:list={{ active: rutaActual === enlace.href }}
                    aria-current={rutaActual === enlace.href ? "page" : undefined}
                  >
                    {enlace.etiqueta}
                  </a>
                ))}
              </nav>

              <div class="profile-area" id="perfil">
                <button class="notification-button" type="button" aria-label="Notificaciones">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span aria-hidden="true" />
                </button>
                <div class="profile-copy">
                  <strong>{nombreUsuario || "Estudiante"}</strong>
                  <span>{sesion.usuario.email}</span>
                </div>
                <div class="avatar" aria-hidden="true">{inicial}</div>
                <a href="/api/logout" class="logout-link">Salir</a>
              </div>
            </div>
          </header>

          <main class="app-main">
            <slot />
          </main>

          <nav class="bottom-navigation" aria-label="Navegación móvil">
            {
              enlacesMoviles.map((enlace) => (
                <a
                  href={enlace.href}
                  class:list={{ active: rutaActual === enlace.href }}
                  aria-current={rutaActual === enlace.href ? "page" : undefined}
                >
                  <span class="bn-icon">
                    <span class="material-symbols-outlined" aria-hidden="true">
                      {enlace.icono}
                    </span>
                  </span>
                  <span class="bn-label">{enlace.etiqueta}</span>
                </a>
              ))
            }
          </nav>
        </div>
      ) : (
        <main class="auth-shell">
          <slot />
        </main>
      )
    }
  </body>
</html>
