---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="mt-6 w-full max-w-md rounded-xl bg-white p-6 shadow-lg ring-1 ring-gray-200">
  <h2 class="text-xl font-semibold text-gray-800">Hello, {name}!</h2>
  <button
    type="button"
    data-greeting-button
    class="mt-4 rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
  >
    Clicked <span data-greeting-count>0</span> times
  </button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-greeting-button]");
  const count = document.querySelector<HTMLSpanElement>("[data-greeting-count]");

  button?.addEventListener("click", () => {
    if (count) {
      count.textContent = String(Number(count.textContent ?? "0") + 1);
    }
  });
</script>
