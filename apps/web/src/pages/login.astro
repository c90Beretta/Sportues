---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
import { getSession } from "../lib/auth";

const sesion = await getSession(Astro.cookies);
if (sesion) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Iniciar sesión · Gimnasio">
  <div class="max-w-md mx-auto mt-16 bg-white rounded-lg shadow p-6">
    <h1 class="text-2xl font-bold mb-1">Bienvenido/a</h1>
    <p class="text-sm text-slate-500 mb-4">
      Ingresá con tu cuenta de estudiante del gimnasio.
    </p>
    <LoginForm client:load />
  </div>
</Layout>