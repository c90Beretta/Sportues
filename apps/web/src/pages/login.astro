---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
import { getSession } from "../lib/auth";

const sesion = await getSession(Astro.cookies);
if (sesion) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Iniciar sesión · Gimnasio">
  <div class="login-stage">
    <section class="login-visual" aria-label="UES Fit">
      <div class="login-brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M13.1 2.3c.3 3-1.9 4.2-3 6.1-.8 1.4-.7 3.1.5 4.2-.1-2.2 1.1-3.4 2.4-4.7.5 2.6 3.4 3.9 3.4 7.1 0 2.7-2 5-4.7 5-2.9 0-5.2-2.2-5.2-5.2 0-3.6 2.5-5.7 6.6-12.5Z" fill="currentColor"></path>
            <path d="M12 12.2c.2 1.5-1 2-1.4 3-.5 1.2.1 2.5 1.4 2.5 1.2 0 2-.9 2-2.1 0-1.5-1.2-2.3-2-3.4Z" fill="#ffae32"></path>
          </svg>
        </span>
        <h2>UES FIT</h2>
        <p>Universidad Estatal de Sonora</p>
      </div>
      <div class="login-message">
        <h1>Tu espacio para moverte mejor.</h1>
        <p>Consulta tu rutina, registra tu acceso y mantén tu progreso en un solo lugar.</p>
      </div>
    </section>
    <div class="login-panel">
      <p class="eyebrow">Acceso de estudiantes</p>
      <h1>Bienvenido de vuelta</h1>
      <p>Ingresa con tu correo institucional y contraseña para continuar.</p>
      <LoginForm client:load />
    </div>
  </div>
</Layout>
