---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm";
import InstitutionalFooter from "../components/InstitutionalFooter.astro";
import { getSession } from "../lib/auth";

const sesion = await getSession(Astro.cookies);
if (sesion) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Iniciar sesión · UES FIT">
  <div class="flex flex-col w-full max-w-md mx-auto items-center justify-between pb-8 px-4 pt-6">
    <div class="relative w-full flex flex-col items-center pt-6 pb-2 overflow-hidden">
      <div class="absolute -top-10 w-48 h-48 bg-secondary-container/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-12 -right-8 w-36 h-36 bg-primary-container/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-state-success animate-pulse"></span>
        <span class="font-heading text-label-sm text-primary uppercase tracking-wider">Torniquetes activos</span>
      </div>

      <div class="relative z-10 w-56 h-20 flex items-center justify-center">
        <img alt="UES FIT" class="max-h-full max-w-full object-contain" src="img/logo-ues-fit.png" />
      </div>

      <p class="font-heading text-label-md text-text-muted text-center mt-3 tracking-wide px-4">
        Acceso al gimnasio - Universidad Estatal de Sonora
      </p>
    </div>

    <div class="w-full bg-surface-container-lowest rounded-2xl shadow-xl p-6 mt-4 relative z-10">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="font-heading text-headline-sm text-on-surface">Portal atleta</h2>
          <p class="text-body-sm text-text-muted">Ingresa con tu cuenta institucional</p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-2xl">fitness_center</span>
        </div>
      </div>

      <LoginForm client:load />

      <div class="mt-6 flex flex-col items-center gap-3">
        <a class="font-heading text-label-md text-secondary hover:text-on-secondary-container transition-colors py-1 px-2 rounded-lg" href="#">
          ¿Olvidaste tu contraseña?
        </a>
        <div class="flex items-center gap-2 text-text-muted text-body-sm">
          <span>¿Eres nuevo ingreso?</span>
          <a class="font-heading text-label-md text-primary font-bold hover:underline" href="/Register">Registrar</a>
        </div>
      </div>
    </div>

    <InstitutionalFooter />
  </div>
</Layout>