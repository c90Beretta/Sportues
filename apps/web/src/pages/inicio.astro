---
import Layout from "../layouts/Layout.astro";
import InicioIsla from "../components/InicioIsla";
import { getSession } from "../lib/auth";
import { apiGet } from "../lib/api";
import type { Usuario } from "@gimnasio/shared";

const sesion = await getSession(Astro.cookies);
if (!sesion) {
  return Astro.redirect("/login");
}

let usuario: Usuario;
try {
  usuario = await apiGet<Usuario>(`/usuarios/${sesion.usuario.id}`, sesion);
} catch {
  return Astro.redirect("/login");
}
---

<Layout title="Inicio · UES FIT" sesion={sesion}>
  <InicioIsla
    nombre={usuario.nombre.split(" ")[0]}
    estadoRegistro={usuario.estadoRegistro ?? "PENDIENTE"}
    client:load
  />
</Layout>