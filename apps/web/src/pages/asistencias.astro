---
import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/auth";
import { apiGet } from "../lib/api";
import type { Asistencia } from "@gimnasio/shared";

const sesion = await getSession(Astro.cookies);
if (!sesion) {
  return Astro.redirect("/login");
}

let asistencias: Asistencia[] = [];
let error: string | null = null;

try {
  asistencias = await apiGet<Asistencia[]>("/asistencias", sesion);
} catch (e) {
  error = e instanceof Error ? e.message : "No se pudieron cargar tus asistencias";
}
---

<Layout title="Historial de asistencia · Gimnasio" sesion={sesion}>
  <h1 class="text-2xl font-bold mb-4">Historial de asistencia</h1>

  {
    error ? (
      <p class="text-red-600 text-sm">{error}</p>
    ) : asistencias.length === 0 ? (
      <div class="bg-white rounded-lg shadow p-6">
        <p class="text-slate-600">Todavía no tenés asistencias registradas.</p>
      </div>
    ) : (
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 text-left">
              <th class="px-4 py-2 font-semibold">Fecha</th>
              <th class="px-4 py-2 font-semibold">Registrada</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {
              asistencias.map((a) => (
                <tr>
                  <td class="px-4 py-2">
                    {new Date(a.fecha).toLocaleDateString("es", {
                      weekday: "long",
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </td>
                  <td class="px-4 py-2 text-slate-500">
                    {new Date(a.createdAt).toLocaleString("es")}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
</Layout>