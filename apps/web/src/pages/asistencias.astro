---
import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/auth";
import { apiGet } from "../lib/api";
import type { Asistencia } from "@gimnasio/shared";

const sesion = await getSession(Astro.cookies);
if (!sesion) {
  return Astro.redirect("/login");
}

let asistencias: Asistencia[] = [];
let error: string | null = null;

try {
  asistencias = await apiGet<Asistencia[]>("/asistencias", sesion);
} catch (e) {
  error = e instanceof Error ? e.message : "No se pudieron cargar tus asistencias";
}
---

<Layout title="Historial de asistencia · Gimnasio" sesion={sesion}>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Tu actividad</p>
      <h1>Historial de asistencia</h1>
      <p>Consulta las visitas que has registrado en el gimnasio.</p>
    </div>
    <span class="status-pill">{asistencias.length} visitas</span>
  </header>

  {
    error ? (
      <p class="ues-card error-state">{error}</p>
    ) : asistencias.length === 0 ? (
      <div class="ues-card empty-state">
        <strong>Aún no hay visitas registradas</strong>
        <p>Tu historial aparecerá aquí después de realizar tu primer check-in.</p>
      </div>
    ) : (
      <div class="ues-card table-card">
        <div class="table-card-header">
          <strong>Visitas recientes</strong>
          <span>Registro personal de accesos</span>
        </div>
        <table class="responsive-table">
          <thead>
            <tr>
              <th>Fecha de visita</th>
              <th>Hora de registro</th>
            </tr>
          </thead>
          <tbody>
            {
              asistencias.map((a) => (
                <tr>
                  <td data-label="Fecha de visita">
                    {new Date(a.fecha).toLocaleDateString("es", {
                      weekday: "long",
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </td>
                  <td data-label="Hora de registro">
                    {new Date(a.createdAt).toLocaleString("es")}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
</Layout>
