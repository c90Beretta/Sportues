---
import Layout from "../../layouts/Layout.astro";
import UESRegistry from "../../components/UESRegistry";
import { getSession } from "../../lib/auth";
import { apiGet } from "../../lib/api";
import type { Usuario } from "@gimnasio/shared";

const sesion = await getSession(Astro.cookies);
if (!sesion) {
  return Astro.redirect("/registro");
}

const usuario = await apiGet<Usuario>(`/usuarios/${sesion.usuario.id}`, sesion);
---
<Layout title="Registro de Atleta · UES FIT">
  <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 px-4 flex items-center justify-between gap-2 max-w-md mx-auto">
      <div class="flex items-center gap-2 min-w-0">
        <img alt="UES FIT" class="h-8 w-auto object-contain" src="/logo-ues-fit.png" />
      </div>
      <span class="font-heading text-headline-sm text-on-surface font-bold truncate max-w-[140px]">Perfil Deportivo</span>
    </div>
  </header>

  <div class="pt-20 pb-8 px-4 max-w-md mx-auto">
    <div class="bg-surface-container-lowest rounded-xl p-4 shadow-sm mb-4">
      <div class="flex items-center justify-between gap-1 mb-2">
        <div class="w-6 h-6 rounded-full bg-state-success text-white flex items-center justify-center">
          <span class="material-symbols-outlined text-[16px]">check</span>
        </div>
        <div class="h-1 flex-1 bg-state-success rounded-full mx-1"></div>
        <div class="flex items-center gap-1">
          <div class="w-6 h-6 rounded-full bg-primary-container text-white flex items-center justify-center">
            <span class="text-label-sm font-bold">2</span>
          </div>
          <span class="font-heading text-label-md text-primary-container font-bold hidden xs:inline">Perfil</span>
        </div>
        <div class="h-1 flex-1 bg-surface-container-highest rounded-full mx-1"></div>
        <div class="w-6 h-6 rounded-full bg-surface-container-highest text-text-muted flex items-center justify-center">
          <span class="text-label-sm">3</span>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <span class="font-heading text-label-sm uppercase tracking-wider text-secondary">Paso 2 de 3 · Registro de Atleta</span>
        <span class="text-label-sm text-text-muted">66% completado</span>
      </div>
    </div>

    <div class="pb-4">
      <h1 class="font-heading text-headline-lg-mobile text-text-primary">Completa tu perfil deportivo</h1>
      <p class="text-body-md text-text-muted mt-1">Personalizaremos tus rutinas y el acceso a las salas de pesas según tu nivel.</p>
    </div>

    <UESRegistry nombre={usuario.nombre} carrera={usuario.carrera ?? ""} client:load />
  </div>
</Layout>