---
import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/auth";

const sesion = await getSession(Astro.cookies);
if (!sesion) {
  return Astro.redirect("/login");
}
---
//Clase placeholder por que no tenemos clases que nos lleven a otra parte el navigation bar
<Layout title="Máquinas · Gimnasio" sesion={sesion}>
  <header class="page-heading">
    <div>
      <p class="eyebrow">Gimnasio UES</p>
      <h1>Máquinas</h1>
      <p>Muy pronto vas a poder ver el catálogo de máquinas disponibles.</p>
    </div>
  </header>
  <div class="ues-card empty-state">
    <strong>Sección en construcción</strong>
    <p>Estamos trabajando en esta vista.</p>
  </div>
</Layout>